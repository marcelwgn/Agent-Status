<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AIStatusTray.BandsItemsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:AIStatusTray.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AIStatusTray"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="OnSizeChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="CommandButtonTemplate" x:DataType="local:CommandViewModel">
                <Button
                    Margin="0,4,0,4"
                    Padding="4,4,4,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="{x:Bind HandleClick}"
                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                    <Grid AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Orientation="Vertical">
                                <!--  CopilotStateIcon for Copilot session buttons  -->
                                <controls:SessionStateIcon
                                    Height="24"
                                    Mode="{x:Bind SessionMode, Mode=OneWay}"
                                    State="{x:Bind SessionState, Mode=OneWay}"
                                    Visibility="{x:Bind HasSessionState, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Orientation="Vertical"
                                Visibility="{x:Bind Name, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <TextBlock
                                    x:Name="TitleTextBlock"
                                    MaxWidth="200"
                                    MaxHeight="40"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextAlignment="Left"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>


                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="DeskbandTemplate" x:DataType="local:TaskbarItemViewModel">
                <Grid
                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                    Background="Transparent"
                    ColumnSpacing="8"
                    Visibility="{x:Bind ShouldBeVisible, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsRepeater
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left"
                        ItemTemplate="{StaticResource CommandButtonTemplate}"
                        ItemsSource="{x:Bind Buttons, Mode=OneWay}">

                        <ItemsRepeater.Layout>
                            <StackLayout
                                x:Name="HorizontalStackLayout"
                                Orientation="Horizontal"
                                Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Height="48"
        Margin="0,0,0,0"
        Orientation="Horizontal">

        <ItemsControl
            x:Name="ItemsBar"
            Grid.Column="0"
            MinWidth="200"
            VerticalAlignment="Stretch"
            Background="Blue"
            BorderBrush="Blue"
            BorderThickness="1"
            IsTabStop="False"
            ItemTemplate="{StaticResource DeskbandTemplate}"
            ItemsSource="{x:Bind BandsDisplayOrder, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Button
            x:Name="MoreButton"
            Padding="4"
            Visibility="Collapsed"
            Style="{StaticResource EllipsisButton}">
            <Grid>
                <Image
                    Width="24"
                    Height="32"
                    Source="/Assets/Deskband.png" />
                <InfoBadge
                    x:Name="OverflowBadge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Value="0" />
            </Grid>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                    <ItemsControl
                        x:Name="OverflowFlyoutItems"
                        MinWidth="240"
                        MaxWidth="380"
                        ItemsSource="{x:Bind OverflowButtons, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CommandViewModel">
                                <Button
                                    Margin="0,2,0,2"
                                    Padding="8,6,8,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="{x:Bind HandleClick}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <controls:SessionStateIcon
                                            Grid.Column="0"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Mode="{x:Bind SessionMode, Mode=OneWay}"
                                            State="{x:Bind SessionState, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />

                                        <ProgressRing
                                            Grid.Column="2"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                            Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
